JIRA_BASE_URL=https://your-jira.example.com
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_read_only_token
JIRA_CLOSED_STATUSES=done,closed,resolved

# Optional MCP defaults per user/workstation.
# When set, MCP tool calls can omit repo_path/branch/person fields.
# FREEIPA_XFAIL_REPO_PATH=/absolute/path/to/freeipa
# FREEIPA_XFAIL_BRANCH=master
# FREEIPA_XFAIL_EXPECTED_ORIGIN=your-github-username
# FREEIPA_XFAIL_PERSON_NAME=Your Name
# FREEIPA_XFAIL_PERSON_EMAIL=you@example.com

# Optional override only. Default is already https://pagure.io.
# PAGURE_BASE_URL=https://pagure.io
# PAGURE_API_TOKEN=optional_read_only_token
PAGURE_CLOSED_STATUSES=closed
